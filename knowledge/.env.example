# ==================== Graph RAG 知识库问答系统 · 环境变量模板 ====================
# 用法：复制本文件为 .env，再按本机实际环境填写。
#   Windows:  copy .env.example .env
#   Linux/mac: cp .env.example .env
# 注意：.env 已在 .gitignore 中排除，请勿把真实密钥提交到仓库。

# -------------------- 大模型（走 API，base_url / key / 模型名在此配置）--------------------
# 视觉/多模态模型名（PDF 图片理解使用；回落文档模型）
VL_MODEL=deepseek-chat
# 文本模型
MODEL=deepseek-chat
ITEM_MODEL=deepseek-chat

# API 接入点与密钥。API_BASE 需填真实地址（官方或自建网关）；模型名按实际可用名填写
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# -------------------- 对象存储（MinIO）--------------------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base

# -------------------- 向量库（Milvus）--------------------
MILVUS_URL=http://127.0.0.1:19530
ITEM_NAME_COLLECTION=item_name_collection
ENTITY_NAME_COLLECTION=entity_collection
CHUNKS_COLLECTION=chunks_collection

# -------------------- 知识图谱（Neo4j）--------------------
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=12345678
NEO4J_DATABASE=neo4j
KG_MAX_SEED_CANDIDATES=3
KG_MAX_TOTAL_SEEDS=10
KG_MAX_TOTAL_CHUNKS=50
KG_MAX_TRIPLES_PER_SEED=100
KG_MAX_TOTAL_TRIPLES=100

# -------------------- 融合与重排序 --------------------
RRF_MAX_RESULTS=10
RRF_K=60
ITEM_NAME_DIAG=1

# -------------------- 动态截断（Rerank 之后）--------------------
# 分数阈值：低于该值的候选丢弃（bge-reranker 原始 logits；0.0 表示丢弃负分）
TRUNCATE_SCORE_THRESHOLD=0.0
# 数量上限：最多保留条数（<=0 不限制）
TRUNCATE_MAX_K=5
# token 预算：累计 token 超过该值即停止追加（<=0 不限制）
TRUNCATE_TOKEN_BUDGET=2000
# 自适应阈值开关：1=启用 score >= mean - factor*std（启用后忽略固定阈值）
TRUNCATE_ADAPTIVE_ENABLED=0
TRUNCATE_ADAPTIVE_STD_FACTOR=0.5

# BGE 本地 Embedding 模型（CPU 执行；首个模型名会自动下载并缓存，或填本地目录路径）
BGE_M3_MODEL=BAAI/bge-m3
BGE_M3_DEVICE=cpu
# BGE Reranker 模型（CPU）：改回 GPU 时设 BGE_RERANKER_DEVICE 为 cuda:0、FP16 为 1
BGE_RERANKER_LARGE=BAAI/bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0

# -------------------- 历史会话（MongoDB）--------------------
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=kb001

# -------------------- MCP 网络搜索（可留空）--------------------
MCP_DASHSCOPE_BASE_URL=